# ============================================================
# 班级工作台 2.0 · Compose 环境变量
# ------------------------------------------------------------
# 用法：复制为 .env（与本文件同目录），改完执行 docker compose up -d
#      不建 .env 时，下面所有值都取等号后的默认值。
# 说明：本服务不连外部数据库 / 缓存 / 消息队列，是单进程自带 SQLite，
#      因此**这里没有任何密码或密钥**，无需填写凭据。
# ============================================================

# --- 端口与监听 ---
# 宿主机端口：浏览器 / 学生手机访问用（容器内固定 20020）
# 改成任何空闲端口都行，二维码和学生端地址会自动跟随，不用改别处
WORKBENCH_PORT=20020
# 宿主机绑定地址：0.0.0.0 = 局域网可访问；127.0.0.1 = 仅本机（前面挂反向代理时用）
WORKBENCH_HOST_IP=0.0.0.0

# --- 对外地址（可选，一般不用填）---
# 留空 = 自动用浏览器访问的地址（改了 WORKBENCH_PORT 也自动正确）
# 只有这两种情况需要填：① 前面挂了 nginx/Caddy 反向代理；
#                      ② 域名与端口对外不一致（如 https://workbench.example.com）
# WB_PUBLIC_URL=http://192.168.x.x:20020

# --- 时区 ---
# 考勤与每日快照按本地日期归档，务必保持中国时区
TZ=Asia/Shanghai

# --- 数据 ---
# 命名卷名。改成别的名字等于换一个空卷，旧数据仍留在原卷里
WORKBENCH_VOLUME=teacher-workbench-data

# --- 镜像 ---
# 本地构建留空即可（默认 teacher-workbench:2.0.1）
# 推 / 拉阿里云 ACR 时填完整仓库地址，例如：
#   IMAGE_REPO=registry.cn-hangzhou.aliyuncs.com/your-namespace/teacher-workbench
IMAGE_REPO=
IMAGE_TAG=2.0.3
