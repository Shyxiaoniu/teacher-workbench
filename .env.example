# ============================================================
# 班级工作台 2.0 · Compose 环境变量
# ------------------------------------------------------------
# 用法：复制为 .env（与本文件同目录），改完执行
#         docker compose up -d
#      不建 .env 时，下面所有值都取等号后的默认值。
# ============================================================

# --- 唯一网页入口 ---
# 老师与学生都访问这个端口： http://<NAS 的局域网 IP>:8080/
#   教师端   /teacher/
#   学生端   /s/
#   QuickForm /qf/
# 换端口只改这里，二维码 / 学生端链接会自动跟浏览器地址走，不用改别处
WEB_PORT=8080

# --- 工作台（不直接对外，只留本机排障通道）---
# 排障用：只在 NAS 本机有效；平时一律走上面的 WEB_PORT
WORKBENCH_DEBUG_PORT=20020
# 对外地址（可选）：留空 = 跟随浏览器访问的地址，一般是正确做法。
# 只有前面还套了一层域名 / 端口映射时才需要写死，如
#   WB_PUBLIC_URL=https://workbench.example.com
WB_PUBLIC_URL=

# --- QuickForm 服务 ---
# 会话加密密钥：**务必换成一串随机值**，否则重启后登录态失效
# 生成：openssl rand -hex 24   （或随便敲 40 位以上无规律字符）
QF_SECRET_KEY=please-change-me-to-a-random-string
# 首次启动自动创建的账号（库里已有账号时不会覆盖，改密码请到网页里改）
QF_ADMIN_USER=wst
QF_ADMIN_PASSWORD=quickform
# QuickForm 镜像（一般本地构建；想固定版本可指定 tag）
QF_IMAGE_TAG=2.5

# --- 内部调用密钥 ---
# 工作台跨容器调用 QuickForm 内部接口时校验，两个服务必须用同一个值。
# 默认值仅用于开箱即用，正式部署建议换成一串随机值：
#   openssl rand -hex 16
WB_INTERNAL_SECRET=wb-internal-change-me

# --- 时区 ---
# 考勤与每日快照按本地日期归档，务必保持中国时区
TZ=Asia/Shanghai

# --- 数据卷 ---
# 命名卷名。改成别的名字等于换一个空卷，旧数据仍留在原卷里
WORKBENCH_VOLUME=teacher-workbench-data
QUICKFORM_VOLUME=teacher-workbench-quickform-data

# --- 镜像仓库（可选）---
# 本地构建留空即可；推 / 拉阿里云 ACR 时填完整仓库地址，例如：
#   IMAGE_REPO=registry.cn-guangzhou.aliyuncs.com/your-namespace/teacher-workbench
IMAGE_REPO=
IMAGE_TAG=2.0
