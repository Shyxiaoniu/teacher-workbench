# ============================================================
# 班级工作台 2.0 · Compose 环境变量
# ------------------------------------------------------------
# 用法：复制为 .env（与本文件同目录），改完执行
#         docker compose up -d
#      不建 .env 时，下面所有值都取等号后的默认值。
# ============================================================

# --- 唯一网页入口 ---
# 老师与学生都访问这个端口： http://<NAS 的局域网 IP>:8080/
#   教师端   /teacher/
#   学生端   /s/
#   课堂活动 /qf/（旧地址兼容，实际界面在教师端「上课」页）
# 换端口只改这里，二维码 / 学生端链接会自动跟浏览器地址走，不用改别处
WEB_PORT=8080

# --- 工作台（不直接对外，只留本机排障通道）---
# 排障用：只在 NAS 本机有效；平时一律走上面的 WEB_PORT
WORKBENCH_DEBUG_PORT=20020
# 对外地址（可选）：留空 = 跟随浏览器访问的地址，一般是正确做法。
# 只有前面还套了一层域名 / 端口映射时才需要写死，如
#   WB_PUBLIC_URL=https://workbench.example.com
WB_PUBLIC_URL=

# --- 课堂活动后端 ---
# builtin = 工作台内置（默认，推荐）：活动 / 提交 / 附件都在 workbench 的库里，
#           不需要任何额外容器，也不再有第二套账号密码。
# qf      = 临时回退到旧 QuickForm 容器（需要自己把 quickform 服务加回 compose，
#           并把 quickform 数据卷挂上）。仅用于对比排障，不建议长期使用。
WB_ACTIVITY_BACKEND=builtin
# 回退模式下方才用到：旧 QuickForm 服务地址
# WB_QUICKFORM_URL=http://quickform:5055

# --- 时区 ---
# 考勤与每日快照按本地日期归档，务必保持中国时区
TZ=Asia/Shanghai

# --- 数据卷 ---
# 命名卷名。改成别的名字等于换一个空卷，旧数据仍留在原卷里
WORKBENCH_VOLUME=teacher-workbench-data
# 旧 QuickForm 数据卷（teacher-workbench-quickform-data）不再由编排创建；
# 存量数据仍在，需要时用「活动管理 → 导入旧 QuickForm 数据」搬进新库。

# --- 镜像仓库（可选）---
# 本地构建留空即可；推 / 拉阿里云 ACR 时填完整仓库地址，例如：
#   IMAGE_REPO=registry.cn-guangzhou.aliyuncs.com/your-namespace/teacher-workbench
IMAGE_REPO=
IMAGE_TAG=2.0
