# 统一换行：容器里跑的是 Linux，sh 脚本 / Dockerfile 必须是 LF，
# 否则会报 "/bin/sh^M: bad interpreter"（Windows 上检出时尤其容易踩）。
* text=auto eol=lf

*.sh        text eol=lf
*.command   text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf

# Windows 批处理保留 CRLF
*.bat       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.ico       binary
*.zip       binary
*.db        binary
