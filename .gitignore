# 运行期数据：含教师密码哈希、班级 / 学生 / 家长信息、上传文件、每日快照
app/data/

# 提交系统的运行期数据：名册含真实学号与姓名、提交记录、上传的作品文件
# （只保留目录说明文件，其余一律不入库）
app/submission-system/data/*
!app/submission-system/data/README.txt

# 本地测试 / 演示辅助脚本：仅供开发调试，不随公开仓库分发
# （如需使用，见仓库外本地备份 _analysis/removed-from-public/）
app/tools/seed_demo.py
docker/smoke-test.sh

# 打包产物（单个 zip 超过 Gitee 100MB 限制，且可从源码重新构建）
*.zip

# 本地分析与备份目录（截图、报告、旧版快照）
_analysis/
_backup/
.workbuddy/

# 各种临时文件
__pycache__/
*.py[cod]
*.log
.DS_Store
Thumbs.db

# 本地环境变量（端口等），不应入库
.env

# 工作台数据快照（含学生真实姓名 / 学号，禁止入库；公开仓库尤其不能有）
workbench.json
workbench-*.json

# ============================================================
# 安全补充（2026-11-03 敏感数据审计）
# 以下目录/文件此前未被忽略，存在误提交真实数据、大文件的风险
# ============================================================

# 课件库：含大体积课件（单个 pptx >100MB，超 GitHub/Gitee 单文件限制）与课堂作品
app/courseware/

# 临时 / AI 产出目录（内部业务产物，不对外）
work_dir/

# 离线运行时与 wheel 包（体积巨大，按需本地构建，不入库）
runtime/
wheels/

# 环境变量本地覆盖（保留示例文件）
.env.*
!.env.example

# 通用数据库文件兜底（任意位置的 SQLite 都不入库）
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 内部审计 / 评估报告：含凭据存放位置、数据清单等敏感描述，只在本地留存
docs/安全审计-*.md
docs/部署可行性分析-*.md
